.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Each person's own Claude Code files, in any folder: not versioned.
CLAUDE.local.md
**/.claude/settings.local.json
# And what Claude Code writes while working inside .claude/: its agents' local memory, its
# worktrees and its runtime state.
**/.claude/agent-memory-local
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/routines/.state/
**/.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.json
**/.claude/agent-registry.json
**/.claude/first-run
**/.claude/assistant-daemon-state.json

# Keys. If a template is needed, the .example is versioned without real keys.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
**/.streamlit/secrets.toml

# Dependencies and local tool state: regenerated and not versioned.
node_modules/
.wrangler/
