{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git fetch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(python3 .github/higiene.py)",
      "Bash(py .github/higiene.py)",
      "PowerShell(py .github/higiene.py)",
      "PowerShell(python3 .github/higiene.py)",
      "Bash(git switch main)",
      "Bash(git switch -c:*)",
      "Bash(git pull)",
      "Bash(gh pr checkout:*)"
    ],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .:*)",
      "Bash(git add ./:*)",
      "Bash(git add -- .:*)",
      "Bash(git add :/:*)",
      "Bash(git add -u:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -fR:*)",
      "Bash(rm --recursive:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "PowerShell(git add -A *)",
      "PowerShell(git add --all *)",
      "PowerShell(git add . *)",
      "PowerShell(git add ./ *)",
      "PowerShell(git add -- . *)",
      "PowerShell(git add :/ *)",
      "PowerShell(git add -u *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
